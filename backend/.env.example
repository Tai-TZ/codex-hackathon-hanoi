# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env lên git.

# ---- LLM ----
# Model tên bắt đầu bằng "gemini" (vd: gemini-3.1-flash-lite) dùng GOOGLE_API_KEY,
# bắt đầu bằng "claude" (vd: claude-haiku-5-5) dùng ANTHROPIC_API_KEY,
# các model còn lại dùng OPENAI_API_KEY.
LLM_MODEL=gpt-5-mini
# Model dự phòng (cách nhau bằng dấu phẩy), dùng khi model chính lỗi hoặc quá tải.
# Có thể trộn hai nhà cung cấp nếu đã điền cả hai key. Ví dụ: gemini-3.5-flash-lite,gemini-2.5-flash
LLM_FALLBACK_MODELS=
# Hỏi Con: model chính chưa trả lời sau từng này giây thì gọi thêm model dự phòng, lấy câu trả lời đầu tiên.
# LLM_STAGGER_SECONDS=6
# Model cho việc nhẹ (câu hỏi chữ ngắn), ví dụ claude-haiku-5-5. Câu có ảnh hoặc dài vẫn dùng LLM_MODEL.
# LLM_LIGHT_MODEL=
# LLM_HEAVY_TEXT_CHARS=300

# Giọng đọc tự nhiên bằng Gemini TTS (dùng GOOGLE_API_KEY). Bỏ trống TTS_MODEL thì app dùng giọng có sẵn của máy.
# TTS_MODEL=gemini-3.8-flash-lite-tts
# TTS_VOICE=Charon
# TTS_FALLBACK_MODELS=gemini-3.8-flash-tts,gemini-2.5-flash-preview-tts
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ---- Telegram (bot báo cho người con) ----
# Token lấy từ @BotFather. CHAT_ID: nhắn cho bot rồi mở /getUpdates; nhiều người cách nhau bằng dấu phẩy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Hỏi Con ----
# DB_PATH=data/hoicon.db
# CHILD_NAME=
# PARENT_TITLE=mẹ

# ---- App ----
APP_ENV=development
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ---- LangSmith (tuỳ chọn, để xem trace của agent) ----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=hackathon-hanoi
