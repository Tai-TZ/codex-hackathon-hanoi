# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env lên git.

# ---- LLM ----
# Model tên bắt đầu bằng "gemini" (vd: gemini-3.1-flash-lite) dùng GOOGLE_API_KEY,
# các model còn lại dùng OPENAI_API_KEY.
LLM_MODEL=gpt-5-mini
# Model dự phòng (cách nhau bằng dấu phẩy), dùng khi model chính lỗi hoặc quá tải.
# Có thể trộn hai nhà cung cấp nếu đã điền cả hai key. Ví dụ: gemini-3.5-flash-lite,gemini-2.5-flash
LLM_FALLBACK_MODELS=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- App ----
APP_ENV=development
CORS_ORIGINS=*
LOG_LEVEL=INFO
# Token dùng chung với app (header X-App-Token). Bắt buộc khi backend public qua internet,
# bỏ trống khi dev. Sinh bằng: openssl rand -hex 24
APP_TOKEN=

# ---- Database ----
# Bỏ trống DATABASE_URL thì lịch sử hội thoại lưu trong RAM (mất khi restart).
# Muốn dùng Postgres trên máy: đặt POSTGRES_PASSWORD (openssl rand -hex 24), chạy `make db`,
# rồi đặt DATABASE_URL=postgresql://app:<POSTGRES_PASSWORD>@localhost:5433/app
POSTGRES_PASSWORD=
DATABASE_URL=

# ---- LangSmith (tuỳ chọn, để xem trace của agent) ----
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=hackathon-hanoi
